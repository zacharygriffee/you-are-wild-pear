{
  "name": "you-are-wild-pear",
  "productName": "You Are Wild",
  "version": "0.1.2",
  "upgrade": "pear://xppppuik8h7kyn7qbf5mukh38s9n3tx1scx4p1r5sqxaio9zjz8o",
  "description": "Sandboxed Pear and Electron desktop host for You Are Wild",
  "author": "Zachary Griffee",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run sync:yaw && electron-forge start -- --no-updates",
    "start:no-sync": "electron-forge start -- --no-updates",
    "sync:yaw": "node scripts/sync-yaw.js",
    "verify:yaw": "node scripts/verify-yaw.js",
    "test": "node --test test/*.test.js",
    "demo:credential-boundary": "electron test/credential-boundary-demo.js",
    "check": "npm run verify:yaw && npm test",
    "package": "npm run sync:yaw && electron-forge package --platform=linux",
    "make": "npm run sync:yaw && electron-forge make --platform=linux",
    "pear:build": "node scripts/pear-release.js build",
    "pear:stage:dry": "node scripts/pear-release.js stage-dry",
    "pear:stage": "node scripts/pear-release.js stage",
    "pear:seed": "node scripts/pear-release.js seed",
    "pear:info": "node scripts/pear-release.js info"
  },
  "dependencies": {
    "bare-path": "3.1.1",
    "corestore": "7.12.0",
    "framed-stream": "1.0.1",
    "hyperswarm": "4.17.0",
    "pear-runtime": "1.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "electron": "40.10.1",
    "electron-forge-plugin-prune-prebuilds": "1.0.1",
    "electron-forge-plugin-universal-prebuilds": "1.0.0",
    "pear-electron-forge-maker-appimage": "2.0.0"
  },
  "allowScripts": {
    "electron@40.10.1": true
  }
}
